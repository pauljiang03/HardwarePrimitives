/-- The value of a finite binary64 word. -/
def val64 (w : ℕ) : ℚ :=
  let e : ℕ := (w / 2 ^ 52) % 2 ^ 11
  let m : ℕ := w % 2 ^ 52
  let mag : ℚ := if e = 0 then (m : ℚ) * 2 ^ (-1074 : ℤ)
    else ((2 ^ 52 + m : ℕ) : ℚ) * 2 ^ ((e : ℤ) - 1075)
  if w / 2 ^ 63 = 1 then -mag else mag

/-- Correctly rounded FP64 by Ozaki-I on a variant equals the oracle on both cases. -/
def agrees64 (P : Model) : Bool :=
  [(A_narrow64, B_narrow64, C_narrow64), (A_wide64, B_wide64, C_wide64)].all fun (A, B, C) =>
    let Aq := A.map (·.map val64)
    let Bq := transpose (B.map (·.map val64))
    (Aq.zip (C.map (·.map val64))).all fun (x, crow) =>
      (Bq.zip crow).all fun (y, c) => mcOzaki1CRD P 11 [5, 6] 175 x y == some c

example : agrees64 cdna3F16 = true := by decide +kernel

