/-- Whether every entry of `C` meets the Grade-A bound `(4k + 1) 2^-53 Σ|xᵢyᵢ|` (the Z3 check
`[P.2]`, which has no underflow term). -/
def gradeAOk (Aq cols C : List (List ℚ)) : Bool :=
  (Aq.zip C).all fun (x, crow) => (cols.zip crow).all fun (y, c) =>
    decide (Rat.abs (c - dot x y) ≤
      (4 * x.length + 1) * 2 ^ (-53 : ℤ) * ((List.zipWith (· * ·) x y).map Rat.abs).sum)

/-- Fixed `W = 55` emulation without guardrails (the Z3 model's `Config(guardrails=False,
fixed_W=55)`). -/
def fixed55 (A B : List (List (BitVec 64))) : Option (List (List ℚ)) := do
  let Aq ← decodeMatrix64 A; let Bq ← decodeMatrix64 B
  Aq.mapM fun x => (transpose Bq).mapM fun y => emulEntry 55 (slicesNeeded 55) x y

/-- The matrix ESC, `W` and slice count of a case. -/
def escWidthSlices (A B : List (List (BitVec 64))) : Option (ℤ × ℕ × ℕ) := do
  let Aq ← decodeMatrix64 A; let Bq ← decodeMatrix64 B
  let esc ← matrixEsc 2 Aq (transpose Bq)
  return (esc, adpWidth esc, slicesNeeded (adpWidth esc))

/-! ## `[T.1]` decoding -/

example : t1Values.all (fun (w, m, e) =>
    value64 w == some ((m : ℚ) * 2 ^ (e - 52)) && ADP.exp64 ((m : ℚ) * 2 ^ (e - 52)) == e) = true := by
  decide +kernel

/-! ## `[T.3]` slice counts -/

example : slicesNeededWith .naiveS8 53 = 8 ∧ slicesNeeded 53 = 7 ∧ slicesNeededWith .floorU8 53 = 7 := by
  decide +kernel

/-! ## `[T.4]` the three encodings agree -/

example : adpWith {} .remap A_t4 B_t4 = (.emulated, decodeMatrix64 C_t4_remap) := by decide +kernel
example : adpWith {} .floorU8 A_t4 B_t4 = (.emulated, decodeMatrix64 C_t4_flooru8) := by decide +kernel
example : adpWith {} .naiveS8 A_t4 B_t4 = (.emulated, decodeMatrix64 C_t4_naives8) := by decide +kernel
example : slicesNeededWith .remap 57 = 8 ∧ slicesNeededWith .floorU8 57 = 8 ∧
    slicesNeededWith .naiveS8 57 = 9 := by decide +kernel

/-! ## `[T.7]` wide exponent ranges -/

example : adp {} A_t7_3 B_t7_3 = (.emulated, decodeMatrix64 C_t7_3) := by decide +kernel
example : escWidthSlices A_t7_3 B_t7_3 = some (5, 59, 8) := by decide +kernel
example : adp {} A_t7_10 B_t7_10 = (.emulated, decodeMatrix64 C_t7_10) := by decide +kernel
example : escWidthSlices A_t7_10 B_t7_10 = some (17, 71, 10) := by decide +kernel

/-! ## `[T.8]` Test 2: guardrails matter -/

example : adp {} A_t8_0 B_t8_0 = (.emulated, decodeMatrix64 C_t8_0) := by decide +kernel
example : escWidthSlices A_t8_0 B_t8_0 = some (0, 54, 7) := by decide +kernel
example : adp {} A_t8_64 B_t8_64 = (.nativeSlow, decodeMatrix64 C_t8_64) := by decide +kernel

/-- Without guardrails, fixed `W = 55` returns the Z3 model's values and meets Grade A at `b = 0`. -/
example : fixed55 A_t8_0 B_t8_0 = decodeMatrix64 C_t8_0_fixed55 := by decide +kernel
example : (do
    let Aq ← decodeMatrix64 A_t8_0; let Bq ← decodeMatrix64 B_t8_0; let C ← fixed55 A_t8_0 B_t8_0
    pure (gradeAOk Aq (transpose Bq) C)) = some true := by decide +kernel

/-- At `b = 64` it returns the Z3 model's values and fails Grade A. -/
example : fixed55 A_t8_64 B_t8_64 = decodeMatrix64 C_t8_64_fixed55 := by decide +kernel
example : (do
    let Aq ← decodeMatrix64 A_t8_64; let Bq ← decodeMatrix64 B_t8_64; let C ← fixed55 A_t8_64 B_t8_64
    pure (gradeAOk Aq (transpose Bq) C)) = some false := by decide +kernel

/-! ## `[T.10]` emergent overflow -/

/-- The products overflow: the emulated path returns no values where the Z3 model returns `+Inf`,
and so does native binary64. -/
example : adp {} A_t10 A_t10 = (.emulated, none) := by decide +kernel
example : escWidthSlices A_t10 A_t10 = some (0, 54, 7) := by decide +kernel
example : (do let Aq ← decodeMatrix64 A_t10; nativeGemm64 Aq (transpose Aq)) = none := by
  decide +kernel

/-! ## `[T.11]` subnormal inputs -/

example : adp {} A_t11 B_t11 = (.emulated, decodeMatrix64 C_t11) := by decide +kernel
example : escWidthSlices A_t11 B_t11 = some (0, 54, 7) := by decide +kernel
example : (do
    let Aq ← decodeMatrix64 A_t11; let Bq ← decodeMatrix64 B_t11; let C ← decodeMatrix64 C_t11
    pure (gradeAOk Aq (transpose Bq) C)) = some true := by decide +kernel
example : (adpSafe {} A_t11 B_t11).1 = .nativeSlow := by decide +kernel

/-! ## `[T.12]` sparse inputs -/

/-- The identity: zeros as `−∞` make the coarsened ESC unbounded, so ADP falls back, and returns
the identity. -/
example : adp {} I_t12 I_t12 = (.nativeSlow, decodeMatrix64 I_t12) := by decide +kernel

end OzakiTCTests.ADPLabels
